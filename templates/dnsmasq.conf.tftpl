# Cluster DNS for the nodes. Everything outside ${cluster_domain} goes upstream.
#
# This file exists because libvirt's own <dns> element can express host records
# but not the *.apps wildcard every cluster route lives under, and the Terraform
# libvirt provider does not expose the dnsmasq XML namespace that could.
# Whether it ANSWERS for the cluster domain or forwards it on is
# cluster_dns_forward_to.

# bind-dynamic, not bind-interfaces: it binds addresses as they appear instead
# of failing at start if the interface is not up yet, and it needs no interface
# NAME, which a cloud image does not reliably give you.
bind-dynamic
listen-address=${listen_address},127.0.0.1

domain-needed
bogus-priv
no-resolv
no-hosts
expand-hosts
domain=${cluster_domain}
%{ if forward_to == "" ~}
# Only when this file IS the authority. With a forwarder configured, local=
# would make dnsmasq answer NXDOMAIN for the whole zone instead of asking.
local=/${cluster_domain}/
%{ endif ~}

${upstream_servers}

%{ if forward_to != "" ~}
# The cluster domain is held somewhere else - a BIND that already runs on this
# network - so this file does not answer for it, it asks. One source of truth
# beats two that agree until they do not, and the records outlive this VM.
server=/${cluster_domain}/${forward_to}
%{ else ~}
# The API, internal and external, both at the load balancer in front of this
# file. api-int is what the nodes themselves use; api is what you use.
host-record=api.${cluster_domain},${lb_address}
host-record=api-int.${cluster_domain},${lb_address}

# Every route the cluster creates - console, oauth, and anything an operator
# publishes - resolves here.
address=/apps.${cluster_domain}/${lb_address}

# Node records, forward and reverse. A node whose PTR does not resolve shows up
# with the wrong name in `oc get nodes`.
${node_records}
%{ endif ~}
