version: 2
ethernets:
  primary:
    match:
      macaddress: "${mac}"
    set-name: eth0
    dhcp4: false
    dhcp6: false
    addresses: [${ip}/${prefix}]
    routes:
      # cloud-init's own parser rejects netplan's `to: default` with
      # "Address default is not a valid ip network" and then silently falls
      # back to DHCP. It wants a real CIDR.
      - to: 0.0.0.0/0
        via: ${gateway}
    nameservers:
      addresses: [${upstream_dns}]
      search: [${cluster_domain}]
